{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // 显式关掉：noEmit 下本来不产出，但父配置开着 declaration 与 sourceMap，
    // 读配置的人会以为测试会生成它们。
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["*.config.ts", "src/**/*", "test/**/*"],
  // artifacts.test.ts 走产物级断言：它 import 的 ../lib/index.js 由 `npm run build` 生成。
  // 类型检查不构建，所以它不属于本项目 —— 留在里面会让「干净检出上跑 typecheck」必失败。
  // 它仍由 `npm test`（自带 build）的 vitest 执行；产物缺失时是失败而不是跳过。
  "exclude": ["src/client", "test/artifacts.test.ts"]
}
