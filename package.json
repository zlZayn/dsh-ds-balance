{
  "name": "dsh-ds-balance",
  "version": "2.0.0-alpha.2",
  "description": "DSH plugin: shows the DeepSeek account balance at the bottom of the sidebar, with a configuration card on the Plugins page.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "balance",
    "usage"
  ],
  "license": "MIT",
  "author": "zlZayn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlZayn/dsh-ds-balance.git"
  },
  "bugs": {
    "url": "https://github.com/zlZayn/dsh-ds-balance/issues"
  },
  "homepage": "https://github.com/zlZayn/dsh-ds-balance#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-alpha.1",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "check:release": "node scripts/check-release.mjs",
    "check:declaration": "node scripts/check-declaration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
